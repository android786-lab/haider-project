# ─── Required ───────────────────────────────────────────────
# JWT secret — minimum 32 characters (use a long random string)
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long

# Supabase project credentials (Dashboard → Settings → API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_service_role_key

# ─── Server ─────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── CORS (frontend URL) ────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# Optional: comma-separated extra origins
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Optional: Cloudinary (payment screenshot uploads) ──────
# If not set, uploads may fail — configure for production
CLOUDINARY_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_SECRET_KEY=your_secret_key

# ─── Optional: Stripe (online payments — legacy feature) ──────
STRIPE_SECRET_KEY=sk_test_...

# ─── Optional: WhatsApp notifications ───────────────────────
# WHATSAPP_API_URL=
# WHATSAPP_API_TOKEN=

# ─── Optional: AI symptom checker ───────────────────────────
# OPENAI_API_KEY=sk-...
